# NASA FIRMS API key is used by the backend only. Never place it in frontend VITE_* variables.
FIRMS_MAP_KEY=

# Browser origins allowed to call the API. Add any Vercel preview domains explicitly.
FIRENEXUS_CORS_ORIGINS=https://firenexus-two.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Conservative local request rate (NASA hard limit: 5,000 transactions per 10 minutes).
FIRMS_REQUESTS_PER_MINUTE=6

# Optional persistent storage root.
# FIRENEXUS_DATA_DIR=./data
